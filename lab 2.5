@media screen and (max-width: 600px) {
    header {
        padding: 12px 5%;
    }

    nav {
        flex-wrap: wrap;
        gap: 10px;
    }

    .menu {
        gap: 12px;
    }

    .menu a {
        font-size: 12px;
    }

    .hero {
        padding: 55px 7% 45px;
    }

    .hero h1 {
        font-size: 48px;
    }

    .hero-text {
        font-size: 16px;
    }

    .section {
        padding: 40px 7%;
    }

    .section h2,
    .closing h2 {
        font-size: 28px;
    }

    .resume-item {
        padding-left: 16px;
    }

    .skills {
        flex-direction: column;
        gap: 15px;
    }

    .skill {
        flex-basis: auto;
    }

    .closing {
        padding: 45px 7%;
    }

    footer {
        padding: 18px 7%;
    }
}
